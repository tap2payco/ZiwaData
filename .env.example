# Copy to .env and fill in. NEVER commit .env. All values are optional for the demo.
# Server
PORT=8787
# Comma-separated extra origins allowed to call the API (e.g. a Capacitor app). Same-origin needs nothing.
CORS_ORIGINS=

# Beem SMS (leave empty to run in DRY-RUN mode: SMS are recorded as "Not sent (dry run)")
BEEM_API_KEY=
BEEM_SECRET_KEY=
# BEEM_API_SECRET is accepted as an alias of BEEM_SECRET_KEY
# Your approved Beem sender ID. Alphanumeric, at most 11 characters. No default, on purpose.
BEEM_SENDER_ID=
# Safety limit for the no-sign-in demo: max SMS the server will send per hour
SMS_MAX_PER_HOUR=5
# Optional shared secret for the delivery-report callback. When set, the URL you give Beem must end
# with ?token=<this value>, and POST /api/sms/dlr refuses anything else. Leave empty only on a laptop.
BEEM_DLR_TOKEN=

# KijaniSpace Space-IoT Box (leave empty to stay in demo mode)
BOX_BASE_URL=https://api.kijanispace.eu
BOX_API_KEY=
BOX_BEARER_TOKEN=

# Sign-in (phone number plus a one-time code by SMS). Off by default: the demo stays open.
# Turn this on only once you have Beem credentials, or nobody can receive a code.
AUTH_REQUIRED=
# Secret used to hash one-time codes and session tokens. Set a long random value for anything that must
# survive a restart: without it a random one is generated per boot and every restart signs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Who gets which role on FIRST sign-in: "phone:role" pairs, comma separated. Roles are farmer, lender,
# extension. Anyone not listed becomes a farmer. Change a role later with SQL; nobody can change their own.
# Example: AUTH_ROLES=255712345678:lender,255713000000:extension
AUTH_ROLES=
# Ceiling on sign-in code SMS per hour across the whole server, so the sign-in form cannot run up a bill.
AUTH_MAX_CODES_PER_HOUR=50

# Where the server keeps its JSON store (default: server/data, which is gitignored)
DATA_DIR=

# Postgres (docker compose up -d). These are LOCAL DEVELOPMENT values, not secrets: the container is
# published on 127.0.0.1 only. Change POSTGRES_PASSWORD to something real before any shared or hosted use.
POSTGRES_DB=ziwadata
POSTGRES_USER=ziwadata
POSTGRES_PASSWORD=localdev
# 5433 and 6379 are already taken by other projects on this machine, so this defaults to 5434.
POSTGRES_PORT=5434
# What the server connects with. Point this at Supabase instead and nothing else has to change.
DATABASE_URL=postgres://ziwadata:localdev@127.0.0.1:5434/ziwadata
